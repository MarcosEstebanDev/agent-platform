{
  "name": "agent-platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Plataforma de orquestacion de agentes, agnostica del proveedor",
  "scripts": {
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:smoke": "tsx --env-file=.env src/db-smoke.ts",
    "smoke": "tsx src/smoke.ts",
    "models": "tsx --env-file=.env src/models.ts",
    "run": "tsx --env-file=.env src/run.ts",
    "api": "tsx --env-file=.env src/api/main.ts",
    "worker": "tsx --env-file=.env src/worker/main.ts",
    "dlq": "tsx --env-file=.env src/dlq.ts",
    "dashboard": "npm --prefix apps/dashboard run dev",
    "dashboard:install": "npm --prefix apps/dashboard install",
    "dashboard:build": "npm --prefix apps/dashboard run build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/domain/*.test.ts src/application/*.test.ts src/infrastructure/sandbox/*.test.ts src/infrastructure/github/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bullmq": "^6.2.0",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
