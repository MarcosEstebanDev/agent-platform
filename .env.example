# Copiar a .env y completar.

# --- LLM: cualquier proveedor compatible con OpenAI ---
#
# Groq (recomendado): free tier sin tarjeta -> console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=PEGA_TU_API_KEY_ACA
LLM_MODEL=openai/gpt-oss-120b
#
# Si el modelo da 404, corrÃ© "npm run models" para ver los que tu key habilita.
#
# Otros proveedores (mismo adapter, solo cambian estas 3 lineas):
#   OpenRouter  https://openrouter.ai/api/v1
#   Cerebras    https://api.cerebras.ai/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama      http://localhost:11434/v1

# --- Sandbox (Docker local) ---
SANDBOX_IMAGE=node:22-bookworm-slim

# 'none' = container sin red (default, mas seguro).
# 'bridge' = con salida a internet, necesario si el agente hace npm install.
SANDBOX_NETWORK=none

# --- Base de datos ---
DATABASE_URL=postgresql://agent:agent@localhost:5433/agent_platform
PORT=3000

# --- Cola (BullMQ / Redis) ---
REDIS_URL=redis://localhost:6380
# Cuantas corridas simultaneas toma un worker. Cada una levanta un container.
WORKER_CONCURRENCY=2

# --- Reaper: cierra corridas cuyo worker murio ---
REAPER_INTERVAL_MS=30000
# Silencio tolerado antes de dar una corrida por muerta. Tiene que ser mayor
# al doble del intervalo de latido (30s), o se cierran corridas vivas.
REAPER_STALE_AFTER_MS=90000

# --- Limpieza de sandboxes huerfanos ---
# Si un worker muere, stop() nunca corre y el container queda vivo. El barrido
# lo destruye cuando la base dice que su corrida ya cerro. La gracia cubre la
# ventana entre marcar la corrida terminada y que stop() alcance a destruirlo.
SANDBOX_ORPHAN_GRACE_MS=60000

# --- Rescate del workspace (se extrae antes de destruir el container) ---
# Comentados = defaults: 512 KB por archivo, 4 MB en total.
# Lo que se pase de esos techos no viaja, y queda registrado como omitido.
#EXPORT_MAX_FILE_BYTES=524288
#EXPORT_MAX_TOTAL_BYTES=4194304
# Directorios podados por nombre, a cualquier profundidad (lista por comas).
#EXPORT_EXCLUDE=node_modules,.git,dist,.next

# --- Presupuestos por corrida (el primero que se agote corta) ---
# Comentados = se usan los defaults del dominio: 25 / 10 min / 100k tokens.
#BUDGET_MAX_ITERATIONS=25
#BUDGET_MAX_WALL_CLOCK_MS=600000
#BUDGET_MAX_TOKENS=100000

# --- GitHub: Pull Requests (fase 2) y gates de calidad (fase 3) ---
# El worker entrega cada corrida como PR y NO arranca sin esto.
# La API arranca igual: sus rutas de GitHub responden 503.
#
# PAT fine-grained (github.com/settings/personal-access-tokens), SOLO sobre el
# repo de prueba, con estos permisos de repositorio:
#   Contents: Read and write       (rama + commit)
#   Pull requests: Read and write  (abrir el PR)
#   Checks: Read-only              (leer los gates)
#   Metadata: Read-only            (lo agrega GitHub solo)
# El token nunca entra al sandbox (ADR 0010) ni a la traza.
GITHUB_TOKEN=PEGA_TU_PAT_ACA
# owner/nombre. Tiene que tener al menos un commit en la rama base.
GITHUB_REPO=tu-usuario/agent-platform-sandbox
#GITHUB_BASE_BRANCH=main
#
# Secreto del webhook (Settings > Webhooks del repo, content type JSON,
# eventos "Check suites" y "Check runs", URL <api>/webhooks/github).
# Sin secreto el webhook queda deshabilitado y el poller cubre igual.
#GITHUB_WEBHOOK_SECRET=
#
# Gates (comentados = defaults de la spec 004)
#GATES_POLL_INTERVAL_MS=60000
#GATES_TIMEOUT_MS=1800000
#GATES_MAX_ATTEMPTS=3
# Checks que avisan pero no bloquean, por nombre exacto (lista por comas).
#GATES_NON_BLOCKING=SonarCloud Code Analysis
