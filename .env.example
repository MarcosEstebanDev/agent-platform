# Copiar a .env y completar.

# --- LLM: cualquier proveedor compatible con OpenAI ---
#
# Groq (recomendado): free tier sin tarjeta -> console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=PEGA_TU_API_KEY_ACA
LLM_MODEL=openai/gpt-oss-120b
#
# Si el modelo da 404, corré "npm run models" para ver los que tu key habilita.
#
# Otros proveedores (mismo adapter, solo cambian estas 3 lineas):
#   OpenRouter  https://openrouter.ai/api/v1
#   Cerebras    https://api.cerebras.ai/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama      http://localhost:11434/v1

# --- Sandbox (Docker local) ---
SANDBOX_IMAGE=node:22-bookworm-slim

# 'none' = container sin red (default, mas seguro).
# 'bridge' = con salida a internet, necesario si el agente hace npm install.
SANDBOX_NETWORK=none
